  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate by Status Code (202 Accepted vs 429 Rate Limited)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status_code, path) (rate(pulse_http_requests_total[1m]))",
          "legendFormat": "HTTP {{status_code}} ({{path}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Gateway Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pulse_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pulse_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pulse_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Live Zone Surge Multipliers (5-Min Sliding Window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pulse_active_surge_multiplier",
          "legendFormat": "{{zone_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saga Orchestrator Executions (Completed vs Compensated Rollback)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pulse_saga_executions_total",
          "legendFormat": "Saga Outcome: {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Go Runtime GC Pause Duration (go_gc_duration_seconds) & Heap Alloc",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "go_gc_duration_seconds",
          "legendFormat": "GC Pause Quantile {{quantile}}",
          "refId": "A"
        }
      ]
    }
  ],
